# Copy this file to .env and fill in your own values.
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)

# File ownership for the ./music downloads.
# Windows / macOS Docker Desktop: leave these at 1000 — Docker Desktop handles it.
# Linux: set to your host user (run `id -u` / `id -g`) so files aren't root-owned.
PUID=1000
PGID=1000

# Your own Spotify API credentials — create a free app at:
#   https://developer.spotify.com/dashboard
# (The bundled/default credentials are rate-limited and cause "Invalid URL" errors.)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
